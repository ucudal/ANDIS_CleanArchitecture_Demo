# Estas pruebas manuales están automatizadas en
# ./test/TaskManagement.API.IntegrationTests/TasksControllerTests.cs.

@host = https://localhost:5001

# El endpoint para generar una tarea requiere autenticación. Generar el token
# requerido con el siguiente comando, ejecutado en la raíz del proyecto:
#
#   dotnet user-jwts create --project ./src/TaskManagement.API/TaskManagement.API.csproj --audience https://localhost:5001 --audience http://localhost:5000 --claim nameid=11111111-1111-1111-1111-111111111111 --claim name=dev-user --output token
#
# y guardarlo en el archivo .env de la raíz del proyecto -no se versiona; ver
# .env.example- con el formato BEARER_TOKEN=<token>. Las pruebas automatizadas
# leen el token del mismo archivo.
@bearerToken = {{$dotenv BEARER_TOKEN}}

# URL de la tarea creada en el endpoint Create Task, tomada del header Location
# de su respuesta. Se usa en los endpoints Get Task By Id y Complete Task, por
# lo que Create Task debe ejecutarse antes que ellos.
@taskUrl = {{createTask.response.headers.Location}}

# Create Task: crea una tarea nueva.
# @name createTask
POST {{host}}/api/tasks
Authorization: Bearer {{bearerToken}}
Content-Type: application/json

{
  "title": "Finish Clean Architecture demo",
  "description": "Wire up in-memory SQLite and verify endpoint tests",
  "priority": "High",
  "dueDate": "2027-05-20T18:00:00Z"
}

###

# Get Task By Id: recupera la tarea creada en el endpoint Create Task.
GET {{taskUrl}}
Accept: application/json

###

# Complete Task: marca como completada la tarea creada en el endpoint Create
# Task. Después de completar la tarea, se puede usar el endpoint Get Task By Id
# para verificar que su estado se ha actualizado a "Completed".
POST {{taskUrl}}/complete
Authorization: Bearer {{bearerToken}}
Accept: application/json
